# Скопіюй у .env і встав свій ключ. .env у .gitignore — у репозиторій не потрапляє.
# Ключ безкоштовно: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Необовʼязково. За замовчуванням gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# --- Опціонально: запис у Google Sheet (прапорець --write-sheet) ---
# 1. Створи service account у Google Cloud Console, увімкни Google Sheets API.
# 2. Завантаж JSON-ключ, шлях до нього — нижче.
# 3. Розшар цільову таблицю на email service account'у (поле client_email
#    у JSON-ключі) з правами Editor.
# 4. ID таблиці — це частина URL між /d/ і /edit.
GOOGLE_SHEETS_CREDENTIALS_FILE=./service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# --- Опціонально: дайджест у Telegram (прапорець --telegram-digest) ---
# Бот: @BotFather -> /newbot -> токен нижче.
# chat_id: додай бота в чат/канал і візьми id через @getidsbot,
# або з https://api.telegram.org/bot<TOKEN>/getUpdates після першого повідомлення боту.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Опціонально: Telegram-бот з живим тріажем (python -m src.bot) ---
# Бот бере той самий пайплайн, але вхід — повідомлення в чаті.
# Потребує GEMINI_API_KEY (працює лише на справжній моделі, не на моці).
# TELEGRAM_ACCESS_WORD — слово-пароль: без нього бот не відповідає нікому.
# Це не стільки приватність, скільки захист квоти: безкоштовний тір Gemini
# дає 5 запитів на хвилину, і відкритий бот вигорів би за хвилину.
TELEGRAM_ACCESS_WORD=придумай-слово
